{
  "expo": {
    "name": "HySafe",
    "slug": "hysafe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/logo1.png",
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "splash": {
      "image": "./src/assets/logo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [ 
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hysafe.mobile"
    },
    "android": {
      "package": "com.hysafe.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo1.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/assets/logo1.png",
      "name": "HySafe",
      "shortName": "HySafe",
      "lang": "en",
      "description": "Order HySafe drinking water, manage recurring deliveries, and track orders.",
      "themeColor": "#0284C7",
      "backgroundColor": "#F0F9FF",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "orientation": "any",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logo1.png",
          "color": "#ffffff"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HySafe to use your location to set delivery addresses and navigate to deliveries."
        }
      ]
    ],
    "scheme": "hysafe"
  }
}
