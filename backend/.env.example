# HySafe Backend Environment Configuration Template
PORT=5000
NODE_ENV=production

# MongoDB connection string. Replace the user, password, and host.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/hysafe?retryWrites=true&w=majority

# Cryptographically Secure JWT Secret (min 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# OTP hash salt. Required whenever NODE_ENV is not development.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# There is no production fallback. A missing or short value disables password reset.
OTP_SALT=replace-with-a-random-string-at-least-16-characters

# Google Sign-In. Client IDs are public identifiers. The web client secret stays on the server.
# GOOGLE_OAUTH_CLIENT_IDS is the audience allow-list (web client ID and Android client ID).
# GOOGLE_OAUTH_REDIRECT_URIS must match the Web client redirect URI exactly.
# The local development redirect is http://localhost:8081/ with one trailing slash.
# Android native sign-in sends an ID token. Its audience is the Web client ID.
# The Android client ID stays in GOOGLE_OAUTH_CLIENT_IDS. Do not add a custom-scheme redirect.
# Production HTTPS origin: not set in this repo. Add it here and in Google Cloud when the domain exists.
# SHA-1 certificate fingerprint: not in this repo. Read it from the EAS or upload keystore.
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:8081/

# Service-area center for orders that include a delivery pin.
# Set these to the same confirmed pin as EXPO_PUBLIC_FACTORY_LAT and EXPO_PUBLIC_FACTORY_LNG
# (8A, T.B Road, Valliyur - 627117). Do not use the mailing address or another city's coordinates.
# If either value is missing or invalid, orders with coordinates are rejected.
# Orders with no coordinates are still accepted. There is no built-in fallback location.
# FACTORY_LAT=
# FACTORY_LNG=
# Optional straight-line radius in kilometers. Defaults to 5. An invalid value rejects coordinated orders.
# SERVICE_RADIUS_KM=5

# Allowed CORS Origins (comma-separated URLs for web admin / dashboard)
CORS_ORIGIN=https://admin.yourdomain.com,https://yourdomain.com

# Resend API Key (Transactional Emails / Password Reset OTP)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="HySafe Support" <support@yourdomain.com>

# Optional SMTP Fallback Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="HySafe Support" <your_email@gmail.com>
