# HySafe Mobile - Environment Configuration
# Expo client variables must begin with EXPO_PUBLIC_ to be exposed to client bundles.

# Backend API base URL (must include /api)
# Development: Leave empty or comment out to auto-detect your local machine IP (http://<LAN-IP>:5000/api)
# Production: Set to your actual production backend URL, e.g.:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=

# Backend Socket URL (origin root without /api)
# Optional: If omitted, will be derived automatically from EXPO_PUBLIC_API_URL (e.g. https://api.yourdomain.com)
# Development: Defaults to http://<LAN-IP>:5000
# EXPO_PUBLIC_SOCKET_URL=https://api.yourdomain.com
EXPO_PUBLIC_SOCKET_URL=

# Public client key for the Google Maps JavaScript API used by the Customer
# address-selection map (WebView). Enable Maps JavaScript API only and apply
# provider-side restrictions. This is not a backend secret.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Checkout's 5 km straight-line eligibility indicator is centered on the
# confirmed client map pin for 8A, T.B Road, Valliyur - 627117.
# Set these from the exact pin in the EAS environment before a production build.
# Do not substitute the business mailing address or a Valliyur town-center point.
# The backend must set FACTORY_LAT and FACTORY_LNG to this same pin. It has no city fallback.
# EXPO_PUBLIC_FACTORY_LAT=
# EXPO_PUBLIC_FACTORY_LNG=
EXPO_PUBLIC_SERVICE_RADIUS_KM=5

# Google Sign-In public client IDs. These identify the app and are safe to ship
# in the client. Never put a Google client secret in an EXPO_PUBLIC_ variable.
# Android Google sign-in uses the Web client ID as the ID token audience.
# It does not send a redirect URI. Use a development or EAS build, not Expo Go.
# Register package com.hysafe.mobile and that build's SHA-1 on the Android OAuth client.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI must match the Web client exactly.
# Local development is http://localhost:8081/ with one trailing slash.
# JavaScript origin stays http://localhost:8081 with no path.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
