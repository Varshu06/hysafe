# HySafe Mobile - Environment Configuration
# Expo client variables must begin with EXPO_PUBLIC_ to be exposed to client bundles.

# Backend API base URL (must include /api)
# Development: Leave empty or comment out to auto-detect your local machine IP (http://<LAN-IP>:5000/api)
# Production: Set to your actual production backend URL, e.g.:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=

# Backend Socket URL (origin root without /api)
# Optional: If omitted, will be derived automatically from EXPO_PUBLIC_API_URL (e.g. https://api.yourdomain.com)
# Development: Defaults to http://<LAN-IP>:5000
# EXPO_PUBLIC_SOCKET_URL=https://api.yourdomain.com
EXPO_PUBLIC_SOCKET_URL=
