{
  "name": "hysafe-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:dashboard\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:dashboard": "cd admin-dashboard && npm run dev",
    "seed:admin": "cd backend && npm run seed:admin",
    "build": "npm run build:backend && npm run build:dashboard",
    "build:backend": "cd backend && npm run build",
    "build:dashboard": "cd admin-dashboard && npm run build"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/animated-tabbar": "^2.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.5.0",
    "expo": "~57.0.0",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.2.0",
    "nativewind": "^2.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-localize": "^3.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.6.1",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.4",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "concurrently": "^8.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
